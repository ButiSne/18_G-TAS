{
  "name": "18gtas-design-vote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/seed.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && pnpm db:migrate && pnpm db:seed",
    "db:psql": "docker compose exec db psql -U gtas -d gtas_dev",
    "ingest": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/ingest.ts",
    "invite": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/invite.ts",
    "brand-assets": "node --experimental-strip-types scripts/brand-assets.ts",
    "ingest:pack": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/ingest-pack.ts",
    "blob:cleanup": "node --env-file-if-exists=.env.local --experimental-strip-types scripts/blob-cleanup.ts"
  },
  "dependencies": {
    "@vercel/blob": "2.8.2",
    "drizzle-orm": "0.45.4",
    "next": "16.4.4",
    "postgres": "3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
