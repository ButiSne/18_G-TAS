# Keep LF in the working tree on every OS. Prettier and CI expect LF, and Windows
# checkouts with core.autocrlf=true otherwise turn every file into CRLF.
* text=auto eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.woff binary
*.woff2 binary
